# Database
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# NextAuth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

## DO OAuth
DIGITALOCEAN_CLIENT_ID=
DIGITALOCEAN_CLIENT_SECRET=

# Redis (for job queue)
REDIS_URL="redis://localhost:6379"
BULLMQ_QUEUE="deployments"

# DigitalOcean (API token for manual deploy tests / Algo env fallback)
DO_API_TOKEN=""

# DigitalOcean OAuth
DIGITALOCEAN_CLIENT_ID=""
DIGITALOCEAN_CLIENT_SECRET=""

# Linode OAuth
LINODE_CLIENT_ID=""
LINODE_CLIENT_SECRET=""

# AWS (for KMS encryption and STS)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
KMS_KEY_ID=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
